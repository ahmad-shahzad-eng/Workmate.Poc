<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Workmate.Poc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ABP Framework (open-source packages only) -->
    <PackageReference Include="Volo.Abp.Autofac" Version="9.1.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="9.1.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.MultiTenancy" Version="9.1.0" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.Sqlite" Version="9.1.0" />
    <PackageReference Include="Volo.Abp.Ddd.Application" Version="9.1.0" />

    <!-- Elsa Workflows 3 (core + management + runtime, in-memory stores by default) -->
    <PackageReference Include="Elsa" Version="3.7.0" />
    <PackageReference Include="Elsa.Persistence.EFCore.Sqlite" Version="3.7.0" />
  </ItemGroup>

</Project>
