{
  "ConnectionStrings": {
    "Default": "Data Source=workmate-poc.db",
    "Elsa": "Data Source=workmate-elsa.db"
  },
  "Poc": {
    "ResetDatabaseOnStartup": false,
    "PublicBaseUrl": "http://localhost:5080",
    "Email": {
      "RetryFirstWaitSeconds": 60,
      "RetryWaitFactor": 2.5
    }
  },
  "Settings": {
    "Abp.Mailing.Smtp.Host": "localhost",
    "Abp.Mailing.Smtp.Port": "1025",
    "Abp.Mailing.Smtp.EnableSsl": "false",
    "Abp.Mailing.Smtp.UseDefaultCredentials": "true",
    "Abp.Mailing.DefaultFromAddress": "no-reply@workmate.local",
    "Abp.Mailing.DefaultFromDisplayName": "Workmate"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
